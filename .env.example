# ── Versi 5.5: semua baca/tulis database lewat SERVER (route handler /api/*) ──
# Browser TIDAK lagi memegang kunci Supabase apa pun. Jangan beri awalan NEXT_PUBLIC_ pada kunci rahasia.

# URL proyek Supabase (aman publik; dipakai server untuk memanggil RPC)
NEXT_PUBLIC_SUPABASE_URL=https://pxsfhknavwwundgcuuym.supabase.co

# KUNCI RAHASIA (server-only). Supabase → Project Settings → API Keys → "secret" (atau service_role).
# Di Vercel: isi sebagai Environment Variable biasa (BUKAN "NEXT_PUBLIC_"), untuk Production + Preview.
SUPABASE_SECRET_KEY=your_secret_key

# Rahasia penandatangan cookie sesi (server-only). Acak & panjang (>= 32 karakter), mis.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Bila kosong, server memakai SUPABASE_SECRET_KEY sebagai cadangan. Mengganti nilai ini = semua orang harus masuk lagi.
SESSION_SECRET=ganti_dengan_string_acak_panjang

# CATATAN Vercel: isi tiap nilai tepat SATU baris tanpa spasi/baris baru/kutip. Server kini membersihkannya otomatis,
# tetapi bila salah, buka /api/health: kolom "code" + "hint" menyebut penyebab persisnya.
# Integrasi Supabase↔Vercel menambah SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / POSTGRES_* — pastikan menunjuk
# proyek BukuDompet (kode di NEXT_PUBLIC_SUPABASE_URL), bukan proyek lain.

# Opsional: koneksi langsung Postgres, hanya untuk menjalankan migrasi dari komputer sendiri.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.pxsfhknavwwundgcuuym.supabase.co:5432/postgres
